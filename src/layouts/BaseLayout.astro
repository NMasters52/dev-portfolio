---
import "../styles/global.css";
import { Icon } from "../components/Icon";
import { profile } from "../lib/profile";

interface Props { title: string; description?: string }
const { title, description = "Software engineering work and writing by Nicholas Masters." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const key = "portfolio-theme";
        const saved = window.localStorage.getItem(key);
        const system = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = saved === "dark" || saved === "light" ? saved : system;
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="/"><span>Nicholas Masters</span><span class="site-brand-suffix">/ portfolio</span></a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
        <button class="theme-toggle" data-theme-toggle type="button" aria-label="Use dark theme" title="Use dark theme">
          <span class="theme-toggle-icon" aria-hidden="true"><Icon name="sun" size={13} strokeWidth={1.8} className="theme-sun" /><Icon name="moon" size={13} strokeWidth={1.8} className="theme-moon" /></span>
        </button>
        <button class="menu-toggle" data-menu-toggle type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
          <Icon name="menu" size={15} strokeWidth={1.8} />
        </button>
      </nav>
    </header>
    <div class="nav-backdrop" data-nav-close></div>
    <section class="nav-sheet" id="site-menu" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="nav-sheet-top">
        <span class="nav-sheet-kicker">Menu</span>
        <button class="nav-sheet-close" data-nav-close type="button" aria-label="Close menu">
          <Icon name="x" size={15} strokeWidth={1.8} />
        </button>
      </div>
      <nav class="nav-sheet-links" aria-label="Primary navigation">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </nav>
      <nav class="nav-sheet-foot" aria-label="More links">
        <a href={profile.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={profile.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={`mailto:${profile.email}`}>Email</a>
        <a href={profile.resumeUrl} target="_blank" rel="noreferrer">Resume</a>
      </nav>
    </section>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>Keep in touch with the work.</p>
        <nav aria-label="Footer links">
          <a href={profile.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
          <a href={profile.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={profile.resumeUrl} target="_blank" rel="noreferrer">Resume</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const themeKey = "portfolio-theme";
        const toggle = document.querySelector("[data-theme-toggle]");
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        if (!(toggle instanceof HTMLButtonElement)) return;

        const updateLabel = () => {
          const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
          const next = theme === "dark" ? "light" : "dark";
          const label = `Use ${next} theme`;
          toggle.setAttribute("aria-label", label);
          toggle.setAttribute("title", label);
          toggle.setAttribute("aria-pressed", String(theme === "dark"));
        };

        updateLabel();
        toggle.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          window.localStorage.setItem(themeKey, next);
          updateLabel();
        });

        media.addEventListener("change", (event) => {
          if (window.localStorage.getItem(themeKey)) return;
          document.documentElement.dataset.theme = event.matches ? "dark" : "light";
          updateLabel();
        });

        const copyButtons = document.querySelectorAll("[data-copy-value]");
        copyButtons.forEach((element) => {
          if (!(element instanceof HTMLButtonElement)) return;
          const value = element.getAttribute("data-copy-value");
          const copyLabel = element.querySelector("[data-copy-label]");
          if (!value) return;

          element.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(value);
              element.classList.add("is-copied");
              if (copyLabel instanceof HTMLElement) copyLabel.textContent = "Copied";
              element.setAttribute("aria-label", "Copied to clipboard");
            } catch {
              element.classList.add("copy-failed");
              if (copyLabel instanceof HTMLElement) copyLabel.textContent = "Copy failed";
              element.setAttribute("aria-label", "Copying to the clipboard failed");
            }

            window.setTimeout(() => {
              element.classList.remove("is-copied", "copy-failed");
              if (copyLabel instanceof HTMLElement) copyLabel.textContent = element.hasAttribute("data-copy-all") ? "Copy all" : "Copy email";
              element.setAttribute("aria-label", element.hasAttribute("data-copy-all") ? "Copy all available contact details" : "Copy email address");
            }, 1600);
          });
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const menuToggle = document.querySelector("[data-menu-toggle]");
        const sheet = document.querySelector(".nav-sheet");
        if (!(menuToggle instanceof HTMLButtonElement) || !(sheet instanceof HTMLElement)) return;

        const setNavOpen = (open) => {
          if (open) root.setAttribute("data-nav-open", "");
          else root.removeAttribute("data-nav-open");
          menuToggle.setAttribute("aria-expanded", String(open));
          if (open) {
            const close = sheet.querySelector("[data-nav-close]");
            if (close instanceof HTMLButtonElement) close.focus();
          } else if (sheet.contains(document.activeElement)) {
            menuToggle.focus();
          }
        };

        menuToggle.addEventListener("click", () => setNavOpen(!root.hasAttribute("data-nav-open")));
        document.querySelectorAll("[data-nav-close]").forEach((element) => element.addEventListener("click", () => setNavOpen(false)));
        document.addEventListener("keydown", (event) => { if (event.key === "Escape") setNavOpen(false); });
        sheet.querySelectorAll(".nav-sheet-links a, .nav-sheet-foot a").forEach((link) => link.addEventListener("click", () => setNavOpen(false)));
        window.matchMedia("(min-width: 601px)").addEventListener("change", (event) => { if (event.matches) setNavOpen(false); });
      })();
    </script>
  </body>
</html>
