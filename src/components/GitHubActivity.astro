---
import type { GithubSnapshot } from "../lib/github-snapshot";
import { profile } from "../lib/profile";

interface Props { snapshot: GithubSnapshot }
const { snapshot } = Astro.props;
const generatedAt = new Intl.DateTimeFormat("en-US", {
  dateStyle: "medium",
  timeZone: "UTC",
}).format(new Date(snapshot.generatedAt));
const calendarDays = snapshot.calendar.flatMap((week) => week.days);
const calendarLabel = `GitHub contribution activity from ${calendarDays[0]?.date ?? snapshot.window.from} through ${calendarDays.at(-1)?.date ?? snapshot.window.to}`;
---
<section class="github-activity" id="github-activity" aria-labelledby="github-activity-heading">
  <div class="container">
    <div class="github-activity-heading">
      <div>
        <p class="kicker">GitHub / Activity</p>
        <h2 id="github-activity-heading">I am pretty committed...</h2>
      </div>
      <p class="github-activity-update">
        Last successful update: <time datetime={snapshot.generatedAt}>{generatedAt}</time>
      </p>
    </div>

    <dl class="github-stat-grid" aria-label="GitHub activity totals for the last 90 days">
      <div class="github-stat"><dt>Commits</dt><dd>{snapshot.totals.commits}</dd><small>last 90 days</small></div>
      <div class="github-stat"><dt>Pull requests</dt><dd>{snapshot.totals.pullRequests}</dd><small>last 90 days</small></div>
      <div class="github-stat"><dt>Issues</dt><dd>{snapshot.totals.issues}</dd><small>last 90 days</small></div>
    </dl>

    <div class="github-calendar-card">
      <div class="github-calendar-heading">
        <div>
          <p class="kicker">Contribution calendar</p>
          <h3>Last 12 months</h3>
        </div>
        <span>{calendarDays.length} days · Rolling totals: {snapshot.window.from}—{snapshot.window.to}</span>
      </div>
      <div class="github-calendar-scroll" role="img" aria-label={calendarLabel}>
        <div class="github-calendar" aria-hidden="true">
          {snapshot.calendar.map((week) => (
            <div class="github-calendar-week">
              {week.days.map((day) => <span class:list={["github-calendar-day", `level-${day.level}`]} title={`${day.date}: ${day.count} contribution${day.count === 1 ? "" : "s"}`} />)}
            </div>
          ))}
        </div>
      </div>
      <div class="github-calendar-legend" aria-hidden="true">
        <span>Less</span><i class="github-calendar-day level-none"></i><i class="github-calendar-day level-low"></i><i class="github-calendar-day level-medium"></i><i class="github-calendar-day level-high"></i><i class="github-calendar-day level-highest"></i><span>More</span>
      </div>
      <div class="github-calendar-footer">
        <details class="github-calendar-details">
          <summary>View daily contribution values</summary>
          <ol>
            {calendarDays.map((day) => <li><time datetime={day.date}>{day.date}</time><span>{day.count} contribution{day.count === 1 ? "" : "s"}</span></li>)}
          </ol>
        </details>
        <a class="github-home-link" href={profile.githubUrl} target="_blank" rel="noreferrer">Open GitHub home <span aria-hidden="true">↗</span></a>
      </div>
    </div>

  </div>
</section>
