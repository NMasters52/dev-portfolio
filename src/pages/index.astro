---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConnectedWork from "../components/ConnectedWork";
import GitHubActivity from "../components/GitHubActivity.astro";
import { BrandIcon, Icon } from "../components/Icon";
import { getProjects, getWritings } from "../lib/content";
import { validateGithubSnapshot } from "../lib/github-snapshot";
import { profile } from "../lib/profile";
import snapshotData from "../data/github-snapshot.json";

const projects = getProjects();
const writings = getWritings();
const githubSnapshot = validateGithubSnapshot(snapshotData);
const copyAllValue = [
  profile.email && `Email: ${profile.email}`,
  profile.phone && `Phone: ${profile.phone}`,
  `GitHub: ${profile.githubUrl}`,
  profile.linkedinUrl && `LinkedIn: ${profile.linkedinUrl}`,
  `Location: ${profile.location}`,
].filter(Boolean).join("\n");
---
<BaseLayout title="Nicholas Masters | Software engineer">
  <section class="intro-section" aria-labelledby="intro-heading">
    <div class="container intro-grid">
      <div class="portrait">
        {profile.portraitUrl ? <img src={profile.portraitUrl} alt={profile.portraitAlt} /> : (
          <><span class="portrait-initials" aria-hidden="true">NM</span><span class="portrait-note">Portrait pending</span></>
        )}
      </div>
      <div class="intro-copy">
        <p class="eyebrow">{profile.role} <span>/ {profile.technologyLine}</span></p>
        <h1 id="intro-heading">{profile.name}</h1>
        <p class="location"><Icon name="map-pin" size={14} strokeWidth={1.8} /> {profile.location}</p>
        <p class="summary">{profile.summary}</p>
      </div>
      <div class="hero-actions" aria-label="Contact links">
        <a class="hero-action" href={profile.githubUrl} target="_blank" rel="noreferrer"><span class="hero-action-content"><BrandIcon brand="github" size={18} /><span>GitHub</span></span></a>
        {profile.linkedinUrl ? (
          <a class="hero-action" href={profile.linkedinUrl} target="_blank" rel="noreferrer"><span class="hero-action-content"><BrandIcon brand="linkedin" size={18} /><span>LinkedIn</span></span></a>
        ) : (
          <span class="hero-action is-pending" aria-label="LinkedIn link pending"><span class="hero-action-content"><BrandIcon brand="linkedin" size={18} /><span>LinkedIn <small>Link pending</small></span></span></span>
        )}
        {profile.resumeUrl ? (
          <a class="hero-action" href={profile.resumeUrl} target="_blank" rel="noreferrer"><span class="hero-action-content"><Icon name="download" size={18} strokeWidth={1.8} /><span>Resume</span></span></a>
        ) : (
          <span class="hero-action is-pending" aria-label="Resume link pending"><span class="hero-action-content"><Icon name="download" size={18} strokeWidth={1.8} /><span>Resume <small>File pending</small></span></span></span>
        )}
        {profile.email ? (
          <button class="hero-action" data-copy-email data-copy-value={profile.email} data-email={profile.email} type="button" aria-label="Copy email address"><span class="hero-action-content"><span class="copy-icon-stack"><Icon name="copy" size={18} strokeWidth={1.8} className="copy-icon" /><Icon name="check" size={18} strokeWidth={2.2} className="copy-success-icon" /></span><span aria-live="polite" aria-atomic="true" data-copy-label>Copy email</span></span></button>
        ) : (
          <span class="hero-action is-pending" aria-label="Email address pending"><span class="hero-action-content"><Icon name="copy" size={18} strokeWidth={1.8} /><span>Copy email <small>Address pending</small></span></span></span>
        )}
      </div>
    </div>
  </section>

  <section class="work" id="work" aria-labelledby="connected-work-heading">
    <div class="container">
      <div class="section-heading">
        <p class="kicker">Connected Work</p>
        <h2 id="connected-work-heading">Shipped work and the thinking behind it.</h2>
      </div>
    </div>
    <div class="container">
      <ConnectedWork client:load projects={projects} writings={writings} />
    </div>
  </section>

  <GitHubActivity snapshot={githubSnapshot} />

  <section class="about-section" id="about" aria-labelledby="about-heading">
    <div class="container about-simple">
      <h2 id="about-heading">About</h2>
      <div class="about-paragraphs">
        <p>Hey, I’m Nicholas Masters. I love building things, understanding why they work, and competing or coaching in disc golf.</p>
        <p>I first got interested in software development in 2020, when COVID shut down the Disc Golf Pro Tour. With competition on pause, I started learning to code through Codecademy. That curiosity stuck with me, even after I took a job as a field manager in the construction industry.</p>
        <p>Field management sharpened a different side of me. I had to manage people, take ownership of problems, and maintain quality in a fast-paced environment where something was always changing. When I inherited communities that had been neglected for months, I fell back on something I've always done naturally: break complicated problems into smaller ones, make a plan, and work through them one at a time.</p>
        <p>That same mindset eventually pulled me deeper into software. I decided I wanted to pursue software development as a career, and that’s where I am now. Building Disc Golf Labs, continuing to sharpen my engineering skills, and trying to understand the “why” behind as much as I can.</p>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-heading">
    <div class="container contact-layout">
      <div class="contact-intro">
        <p class="kicker">Contact / Let's talk</p>
        <h2 id="contact-heading">Want to work on something together?</h2>
        <p>Reach out about a project, one of the things I'm building, or a role where thoughtful work matters. Email is the fastest way to get me.</p>
      </div>
      <div class="contact-card">
        <div class="contact-card-heading">
          <div>
            <p class="kicker">Contact details</p>
            <h3>Pick a route.</h3>
          </div>
          <button class="contact-copy-all" data-copy-all data-copy-value={copyAllValue} type="button" aria-label="Copy all available contact details">
            <span class="copy-icon-stack"><Icon name="copy" size={15} strokeWidth={1.8} className="copy-icon" /><Icon name="check" size={15} strokeWidth={2.2} className="copy-success-icon" /></span>
            <span data-copy-label>Copy all</span>
          </button>
        </div>
        <div class="contact-detail-list" aria-label="All contact details">
          {profile.email && <div class="contact-detail"><div><span class="contact-detail-label">Email</span><a href={`mailto:${profile.email}`}>{profile.email}</a></div><button class="contact-copy" data-copy-value={profile.email} type="button" aria-label="Copy email address"><span class="copy-icon-stack"><Icon name="copy" size={15} strokeWidth={1.8} className="copy-icon" /><Icon name="check" size={15} strokeWidth={2.2} className="copy-success-icon" /></span></button></div>}
          <div class:list={["contact-detail", { "is-pending": !profile.phone }]}>
            <div><span class="contact-detail-label">Phone</span>{profile.phone ? <a href={`tel:${profile.phone}`}>{profile.phone}</a> : <span class="contact-detail-value">Not listed yet</span>}</div>
            {profile.phone && <button class="contact-copy" data-copy-value={profile.phone} type="button" aria-label="Copy phone number"><span class="copy-icon-stack"><Icon name="copy" size={15} strokeWidth={1.8} className="copy-icon" /><Icon name="check" size={15} strokeWidth={2.2} className="copy-success-icon" /></span></button>}
          </div>
          <div class="contact-detail"><div><span class="contact-detail-label">GitHub</span><a href={profile.githubUrl} target="_blank" rel="noreferrer">github.com/NMasters52</a></div><button class="contact-copy" data-copy-value={profile.githubUrl} type="button" aria-label="Copy GitHub address"><span class="copy-icon-stack"><Icon name="copy" size={15} strokeWidth={1.8} className="copy-icon" /><Icon name="check" size={15} strokeWidth={2.2} className="copy-success-icon" /></span></button></div>
          {profile.linkedinUrl && <div class="contact-detail"><div><span class="contact-detail-label">LinkedIn</span><a href={profile.linkedinUrl} target="_blank" rel="noreferrer">linkedin.com/in/nicholas-masters</a></div><button class="contact-copy" data-copy-value={profile.linkedinUrl} type="button" aria-label="Copy LinkedIn address"><span class="copy-icon-stack"><Icon name="copy" size={15} strokeWidth={1.8} className="copy-icon" /><Icon name="check" size={15} strokeWidth={2.2} className="copy-success-icon" /></span></button></div>}
          <div class="contact-detail"><div><span class="contact-detail-label">Location</span><span class="contact-detail-value">{profile.location}</span></div><button class="contact-copy" data-copy-value={profile.location} type="button" aria-label="Copy location"><span class="copy-icon-stack"><Icon name="copy" size={15} strokeWidth={1.8} className="copy-icon" /><Icon name="check" size={15} strokeWidth={2.2} className="copy-success-icon" /></span></button></div>
          {profile.resumeUrl && <div class="contact-detail"><div><span class="contact-detail-label">Resume</span><a href={profile.resumeUrl} target="_blank" rel="noreferrer">Open resume</a></div><a class="contact-open" href={profile.resumeUrl} target="_blank" rel="noreferrer" aria-label="Open resume"><Icon name="external-link" size={15} strokeWidth={1.8} /></a></div>}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
